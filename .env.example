# Personal cloud storage - example configuration
# Copy this file to .env and fill in real values
# Личное облако - пример конфигурации
# Скопируйте этот файл в .env и заполните реальными значениями

# Username for the first user (administrator)
# On first start, a user with this username will be created
# Логин первого пользователя (администратора)
# При первом запуске будет создан пользователь с этим логином
CLOUD_ADMIN_USERNAME=admin

# IMPORTANT: Change this to a strong password before deploying!
# Password for the first user (administrator)
# ВАЖНО: Измените на надёжный пароль перед деплоем!
# Пароль первого пользователя (администратора)
CLOUD_ADMIN_PASSWORD=admin

# Secret key for signing JWT tokens
# IMPORTANT: Use a long random string in production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Секретный ключ для подписи JWT токенов
# ВАЖНО: Используйте длинную случайную строку в продакшене!
# Можно сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
CLOUD_JWT_SECRET=change_me_in_production

# JWT token lifetime in days
# Срок действия JWT токена в днях
CLOUD_JWT_EXPIRE_DAYS=7
